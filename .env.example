# Used only by the local Vite proxy (npm run dev). Never prefix these with VITE_
# or they will be copied into the browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: still inlined in the client build. Use a long random string.
VITE_STORAGE_PASSPHRASE=change-this-to-a-strong-random-string-in-production
