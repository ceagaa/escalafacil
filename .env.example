# EscalaFácil — variáveis do front-end (Vite)
#
# A API, a autenticação e o banco (Cloudflare Worker + D1) rodam no mesmo
# domínio do site — nenhuma chave de backend é necessária aqui.

# Opcional: frase usada para criptografar o cache da escala no localStorage
# (se ausente, o app usa o valor embutido de desenvolvimento).
VITE_STORAGE_PASSPHRASE=change-this-to-a-strong-random-string-in-production
